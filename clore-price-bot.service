[Unit]
Description=Clore.ai Price Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/clore
ExecStart=/var/www/clore/venv/bin/python /var/www/clore/bot.py
Restart=always
RestartSec=10
Environment="CLORE_API_KEY=key"
Environment="CLORE_SERVER_ID=id"
Environment="CLORE_SERVER_NAME=name"
Environment="CLORE_GPU_MODEL=RTX 5080"
Environment="CLORE_UPDATE_INTERVAL=5"
Environment="CLORE_API_URL=https://api.clore.ai/v1"

[Install]
WantedBy=multi-user.target
